# Copy to .env and adjust. Defaults match docker-compose.yml.

# local | test | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://talkischeap:talkischeap@localhost:5432/talkischeap
# Set to true to log every SQL statement
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# Companies, filing forms, history window, and the names news is matched by
UNIVERSE_FILE=universe.yaml

# Required to load data from SEC EDGAR: your name and a contact email.
# The SEC requires this on every request (https://www.sec.gov/os/accessing-edgar-data).
# Archive and Finnhub requests carry it as their contact too.
EDGAR_IDENTITY=
# Where edgartools caches SEC responses
EDGAR_DATA_DIR=.cache/edgar

# News feeds and backfill sources
FEEDS_FILE=feeds.yaml
# Publishers searched in the web archives (`talk-is-cheap ingest archives`)
ARCHIVES_FILE=archives.yaml
# Every answer of Common Crawl, the Wayback Machine and Finnhub, so nothing is fetched twice
NEWS_CACHE_DIR=.cache/news
# Finnhub company news (`talk-is-cheap ingest finnhub`): a free key from finnhub.io. The free
# tier is licensed for personal use. Empty: the command is skipped. Never commit a key.
FINNHUB_API_KEY=
# User-Agent sent to news feeds and GDELT
NEWS_USER_AGENT="talk-is-cheap/0.1 (news headline collector; metadata only)"
# User-Agent sent when fetching article pages for statement extraction; its first word
# is the robots.txt user agent obeyed
ARTICLE_USER_AGENT="talk-is-cheap/0.1 (research: reads executive quotes in company news, follows robots.txt, at most one request per second per site)"

# Local models for search (fastembed). Changing EMBEDDING_MODEL re-embeds everything
# on the next `talk-is-cheap index`.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Where the models are downloaded (about 150 MB)
MODEL_CACHE_DIR=.cache/fastembed

# The LLM for guidance extraction (`talk-is-cheap extract guidance`) and every node of the
# agent (`talk-is-cheap ask`, the API's chat), through LangChain. Never commit a key.
# For the API only, `fake` answers with a scripted model at no cost (not in production).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Anthropic reasoning effort: low, medium, high, xhigh or max; empty for the model's default
LLM_EFFORT=low
# API key of the provider (ANTHROPIC_API_KEY is read too)
LLM_API_KEY=
# Hard cap on all LLM spending recorded in the ledger (`talk-is-cheap spend`), in US dollars
LLM_BUDGET_USD=3.00
# A run stops before a call that could take its own spending over this many US dollars
# (`ask` and `eval agent` take --max-cost instead)
LLM_COST_CAP=10.00
# US dollars per million tokens, for models without a list price in guidance/llm.py
LLM_INPUT_PRICE=
LLM_OUTPUT_PRICE=
# Every model response, so re-runs cost nothing
LLM_CACHE_DIR=.cache/llm

# HTTP API (`talk-is-cheap serve`, `make api`, docs/api.md)
# Comma-separated keys clients send in X-API-Key. Empty: every request is let in, which
# only `local` and `test` allow; the API refuses to start in production without keys.
API_KEYS=
# Requests per minute and key: chat questions, and everything else (429 with Retry-After)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE=120
# US dollars chat questions may spend per UTC day: each key, and all keys together. On top
# of LLM_BUDGET_USD.
DAILY_LLM_BUDGET_USD=0.25
DAILY_LLM_BUDGET_TOTAL_USD=1.00
# Comma-separated origins a browser UI may call the API from
CORS_ORIGINS=
# A chat question that takes longer stops with an error event; a tool call that takes
# longer returns an error to the model ("try a narrower query or another tool")
CHAT_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=10
# Host port of the API in docker-compose.yml
API_PORT=8080

# Web UI (`talk-is-cheap ui`, `make ui`, docs/ui.md). It calls the API from its own server;
# the key is never sent to browsers. docker-compose.yml sets UI_API_URL to the api service.
UI_API_URL=http://127.0.0.1:8080
# One of API_KEYS; empty when the API runs without keys. Never commit a key.
UI_API_KEY=
# Port of `make ui`, and host port of the UI in docker-compose.yml
UI_PORT=8501
