# Copy to .env and adjust. Every variable is optional; defaults match docker-compose.yml.

# local | test | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://talkischeap:talkischeap@localhost:5432/talkischeap
# Set to true to log every SQL statement
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
